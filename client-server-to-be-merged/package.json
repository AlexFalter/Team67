{
  "name": "capsule-race",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm run dev -w @race/server\" \"npm run dev -w @race/client\"",
    "build": "npm run check && npm run build -w @race/client",
    "check": "tsc --noEmit",
    "start": "npm start -w @race/server",
    "bots": "tsx apps/server/src/bots.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
